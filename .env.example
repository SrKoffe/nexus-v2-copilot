# ─────────────────────────────────────────────────────────────────
#  Nexus V2 Co-Pilot — Environment Configuration
#
#  Copy this file to `.env` (no extension prefix) and fill in your
#  MEXC API credentials. The `.env` file is gitignored — never commit.
# ─────────────────────────────────────────────────────────────────

# MEXC futures API key (READ-ONLY permissions only — no trade scope!)
#   Create at: https://www.mexc.com/user/openapi
#   Required perm: "Futures - View Account / Positions"
#   Forbidden perm: "Futures - Trade" (must NOT be enabled)
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here
